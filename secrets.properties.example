# Copy to secrets.properties (git-ignored) or put these lines in local.properties.
# Get the values at https://my.telegram.org -> API development tools.
# NEVER commit real values.
telegram.apiId=1234567
telegram.apiHash=0123456789abcdef0123456789abcdef
# Optional: use Telegram's test servers (separate accounts, see docs/TELEGRAM_SETUP.md).
telegram.useTestDc=false
