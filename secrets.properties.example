# Copy to secrets.properties (git-ignored) or put these lines in local.properties.
# Get the values at https://my.telegram.org -> API development tools.
# NEVER commit real values.
telegram.apiId=1234567
telegram.apiHash=0123456789abcdef0123456789abcdef
# Optional: use Telegram's test servers (separate accounts, see docs/TELEGRAM_SETUP.md).
telegram.useTestDc=false

# ---- Metadata (optional) ----
# TMDB: create a free account at themoviedb.org → Settings → API. Use either key.
tmdb.apiKey=
tmdb.readToken=
# Provider order (fallback goes left to right). Known: tmdb, cinemeta
metadata.providers=tmdb,cinemeta
# Language for titles/overviews (ISO 639-1)
metadata.language=en

# ---- Catalogs (optional) ----
# Title lists for discovery (trending, per Indian language). Catalog titles are NOT playable:
# watching always goes through your own Telegram library. See docs/CATALOGS.md.
# Known: indiastreams, indian_regional. Order = fallback order. "none" disables all.
catalog.providers=indiastreams,indian_regional
# Extra Stremio-compatible catalog add-ons (manifest URLs, comma-separated). Only their
# catalog/meta resources are used, never streams.
catalog.customManifests=
