<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Launch screen: the app's speech-bubble logo on ink black while the app starts (Android 12+
        system splash, back-ported by core-splashscreen). Then the app's own theme, and the short
        animated intro (LaunchIntro) takes over from the same picture.
    -->
    <style name="Theme.YourStream.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.YourStream</item>
    </style>

    <style name="Theme.YourStream" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_ink</item>
    </style>
</resources>
